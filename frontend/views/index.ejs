<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mini Chatbox</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-container">
    <header class="app-header">
      <div class="logo-area">
        <span class="logo-icon">💬</span>
        <div>
          <h1>Mini Chatbox</h1>
          <p class="subtitle">Connect instantly, share ideas</p>
        </div>
      </div>
      <a href="/chats/new" class="btn btn-primary">
        <span class="icon">➕</span> New Chat
      </a>
    </header>

    <main class="chats-list">
      <% if (!chats || chats.length === 0) { %>
        <div class="empty-state">
          <span class="empty-icon">🏜️</span>
          <h3>No chats yet</h3>
          <p>Be the first to start a conversation!</p>
          <a href="/chats/new" class="btn btn-primary">Start Chat</a>
        </div>
      <% } else { %>
        <% let i = 0; %>
        <% for (let chat of chats) { %>
          <div class="chat-card">
            <div class="chat-header">
              <div class="user-badge from-badge">
                <span class="badge-label">From</span>
                <span class="user-name"><%= chat.from %></span>
              </div>
              <div class="connector">➡️</div>
              <div class="user-badge to-badge">
                <span class="badge-label">To</span>
                <span class="user-name"><%= chat.to %></span>
              </div>
            </div>

            <div class="chat-body">
              <p class="chat-message msg-grad-<%= (i % 5) + 1 %>"><%= chat.message %></p>
            </div>

            <div class="chat-footer">
              <span class="chat-time">
                🕒 <%= chat.created_at ? chat.created_at.toString().split(" ")[4] : "No Time" %>
                &bull;
                <%= chat.created_at ? chat.created_at.toString().split(" ").slice(0,4).join(" ") : "No Date" %>
              </span>
              <div class="chat-actions">
                <a href="/chats/<%= chat._id %>/edit" class="btn-action btn-edit" title="Edit Message">
                  ✏️ Edit
                </a>
                <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this chat?');">
                  <button type="submit" class="btn-action btn-delete" title="Delete Message">
                    🗑️ Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
          <% i++; %>
        <% } %>
      <% } %>
    </main>
  </div>
</body>
</html>