<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Write New Chat</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

<h1>✍ Write New Chat</h1>

<div class="chat">
  <form method="POST" action="/chats">
    <input placeholder="Who are you?" name="from" required />
    <input placeholder="Add receiver name" name="to" required />

    <textarea
      name="message"
      rows="5"
      placeholder="Write your message here..."
      required
    ></textarea>

    <div class="center">
      <button class="button">🚀 Create Chat</button>
    </div>
  </form>
</div>

</body>
</html>