 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Mini Chatbox</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

<h1>💬 All Chats</h1>

<form method="GET" action="/chats/new" class="center">
  <button class="button">➕ New Chat</button>
</form>

<% for (let chat of chats) { %>
  <div class="chat">

    <p><b>From:</b> <%= chat.from %></p>
    <p><b>To:</b> <%= chat.to %></p>

    <div class="message">
      <%= chat.message %>
    </div>

    <p>
      <small>
        <%= chat.created_at.toString().split(" ")[4] %> |
        <%= chat.created_at.toString().split(" ").slice(0,4).join(" ") %>
      </small>
    </p>

    <form method="GET" action="/chats/<%= chat._id %>/edit">
      <button class="button2">✏ Edit</button>
    </form>

    <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
      <button class="button3">🗑 Delete</button>
    </form>

  </div>
<% } %>

</body>
</html>